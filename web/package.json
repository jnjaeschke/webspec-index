{
  "name": "webspec-index-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "prepare:wasm": "node scripts/prepare.mjs wasm",
    "prepare:db": "node scripts/prepare.mjs db",
    "dev": "npm run prepare:wasm && vite",
    "build": "npm run prepare:wasm && tsc --noEmit && vite build",
    "build:mock": "VITE_BACKEND=mock tsc --noEmit && VITE_BACKEND=mock vite build",
    "build:e2e": "WEBSPEC_SKIP_PUBLIC_DB=1 npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node e2e/app.spec.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.1",
    "@testing-library/preact": "^3.2.4",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
